{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true, // don't place JS everywhere while hacking
    "baseUrl": ".", // Bun & editors see the aliases
    "paths": {
      "@nexus/common/*": ["./common/src/*"],
      "@nexus/sdk": ["./sdk/src/index.ts"],
      "@nexus/sdk/*": ["./sdk/*"],
      "@nexus/agent-runtime/*": ["./packages/agent-runtime/src/*"],
      "@nexus/llm-providers/*": ["./packages/llm-providers/src/*"],
      "@nexus/billing/*": ["./packages/billing/src/*"],
      "@nexus/bigquery/*": ["./packages/bigquery/src/*"],
      "@nexus/internal/*": ["./packages/internal/src/*"],
      "@nexus/code-map/*": ["./packages/code-map/*"]
    }
  },
  "files": [],
  "references": [
    { "path": "./common" },
    { "path": "./web" },
    { "path": "./evals" },
    { "path": "./sdk" },
    { "path": "./packages/billing" },
    { "path": "./packages/bigquery" },
    { "path": "./packages/llm-providers" },
    { "path": "./packages/internal" },
    { "path": "./packages/code-map" },
    { "path": "./scripts" }
  ]
}
