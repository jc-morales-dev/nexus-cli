# ── NVIDIA NIM (free, BYOK direct inference) ──────────────────────────────
# Personal NVIDIA key (format: nvapi-...). Get a free one at https://build.nvidia.com
# When set, models routed by isNvidiaModel (ids starting with "nvidia/" or
# "z-ai/", e.g. z-ai/glm-5.1) hit NVIDIA directly — no Codebuff account/credits.
# NOTE: NVIDIA's free tier is credit-limited; inference returns 403 once credits
# run out even though the key can still list models.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: override the inference endpoint (defaults to NVIDIA NIM). Point this
# at any OpenAI-compatible base URL to use a different free provider.
# NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1

# ── OpenRouter (free, BYOK direct inference — RECOMMENDED) ─────────────────
# Personal OpenRouter key (format: sk-or-...). Get one free at
# https://openrouter.ai/keys . When set, ALL model requests go DIRECTLY to
# OpenRouter, bypassing the Codebuff backend — no Codebuff account/credits.
# OpenRouter hosts the same model ids the agents already use.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional global override: force EVERY agent onto one model id. Use a ":free"
# model to keep the whole CLI free. Leave empty to let each agent pick its own.
CODEBUFF_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# In BYOK mode there is no Codebuff account, but the CLI needs a non-empty value
# here so it skips the login screen (user info is stubbed locally). Any string.
CODEBUFF_API_KEY=byok-local-dummy

# AI API Keys
CLAUDE_CODE_KEY=dummy_claude_code_key
OPEN_ROUTER_API_KEY=dummy_openrouter_key
OPENAI_API_KEY=dummy_openai_key
ANTHROPIC_API_KEY=dummy_anthropic_key
FIREWORKS_API_KEY=dummy_fireworks_key
CANOPYWAVE_API_KEY=dummy_canopywave_key
SILICONFLOW_API_KEY=dummy_siliconflow_key
OPENCODE_API_KEY=dummy_opencode_key

# Database & Server
DATABASE_URL=postgresql://manicode_user_local:secretpassword_local@localhost:5432/manicode_db_local
PORT=4242

# Authentication
CODEBUFF_GITHUB_ID=dummy_github_id
CODEBUFF_GITHUB_SECRET=dummy_github_secret
FREEBUFF_GITHUB_ID=dummy_freebuff_github_id
FREEBUFF_GITHUB_SECRET=dummy_freebuff_github_secret
NEXTAUTH_SECRET=dummy_nextauth_secret_at_least_32_chars_long

# Payment (Stripe)
STRIPE_SECRET_KEY=sk_test_dummy_stripe_secret
STRIPE_WEBHOOK_SECRET_KEY=whsec_dummy_webhook_secret
STRIPE_TEAM_FEE_PRICE_ID=price_dummy_team_fee_id
STRIPE_SUBSCRIPTION_100_PRICE_ID=price_dummy_subscription_100_id
STRIPE_SUBSCRIPTION_200_PRICE_ID=price_dummy_subscription_200_id
STRIPE_SUBSCRIPTION_500_PRICE_ID=price_dummy_subscription_500_id

# External Services
