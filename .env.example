# ── OpenRouter (BYOK direct inference) ────────────────────────────────────
# Your personal OpenRouter key (format: sk-or-...). Get one free at
# https://openrouter.ai/keys . When set, ALL model requests go DIRECTLY to
# OpenRouter — no account, no backend, no credits system.
#
# NOTE: end users don't need this file. They paste their key inside the CLI
# with the /key command, which stores it locally. This .env is only for
# local development.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Model selection ───────────────────────────────────────────────────────
# Option A — single forced model for EVERY agent (highest priority). Leave
# empty to use the tiered map below. Examples (price per 1M out tokens, approx):
#   FREE (rate-limited):  nvidia/nemotron-3-super-120b-a12b:free
#   CHEAP (recommended):  deepseek/deepseek-v3.2   (~$0.34, edits well)
#   PREMIUM:              z-ai/glm-5.2             (~$3.00)
NEXUS_MODEL=

# Option B — tiered map (RECOMMENDED): STRONG for editing/reasoning, CHEAP for
# utility agents (file search, context pruning). More reliable AND usually
# cheaper, since token-heavy utility work runs on the cheap model.
NEXUS_MODEL_STRONG=deepseek/deepseek-v3.2
NEXUS_MODEL_CHEAP=deepseek/deepseek-v4-flash

# In BYOK mode there is no account, but the CLI needs a non-empty value here so
# it skips the login screen (user info is stubbed locally). Any string works.
NEXUS_API_KEY=byok-local-dummy

# ── Optional ──────────────────────────────────────────────────────────────
# Abort inference if no token arrives within this many ms (default 120000).
# NEXUS_INFERENCE_TIMEOUT_MS=120000
# Self-hosted SearXNG instance for higher-quality keyless web search.
# NEXUS_SEARXNG_URL=http://localhost:8080
